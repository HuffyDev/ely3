# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- Claude API (AI review; findings from it are always REVIEW level) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=high
# Hard daily spend cap for all AI calls, in USD. Scans skip AI review once reached.
AI_DAILY_BUDGET_USD=5
# Per-scan limits: source larger than this (estimated tokens) is not sent to the AI.
AI_MAX_INPUT_TOKENS_PER_SCAN=60000
AI_MAX_OUTPUT_TOKENS_PER_SCAN=8000

# --- Elysium network (read-only) ---
# Mainnet RPC. The chain ID is read from this endpoint with eth_chainId, never hardcoded.
ELYSIUM_RPC_URL=
# Testnet RPC (reported chain 99801; verified at startup).
ELYSIUM_TESTNET_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
# Explorer API used for verified source and address history (Blockscout or Etherscan-compatible).
EXPLORER_API_URL=https://elyscan.live/api
EXPLORER_API_KEY=

# --- Local tools (leave blank to use PATH) ---
ANVIL_PATH=
FORGE_PATH=
SLITHER_PATH=
SOLC_PATH=
FORK_PORT_BASE=8600

# --- Secrets generated by you (e.g. `openssl rand -hex 32`) ---
# Encrypts stored fork proofs and private privacy reports (AES-256-GCM). 64 hex chars.
PROOF_ENCRYPTION_KEY=
# Signs privacy-report sessions. 64 hex chars.
SESSION_SECRET=
# Operator console token (disclosures, approvals, ledger entries). Long random string.
OPERATOR_TOKEN=

# --- App ---
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=./data
# Run the scan worker inside the web process (good for Replit / single machine).
RUN_WORKER_IN_PROCESS=true
# Watch new Elysium deployments (needs ELYSIUM_RPC_URL).
WATCHER_ENABLED=false
WATCHER_MAX_ANALYSES_PER_HOUR=20
SCANS_PER_IP_PER_HOUR=12
DISCLOSURE_WAIT_DAYS=90
# Enables the local demo network (our own contracts on a local Anvil chain). Never points at a live network.
DEMO_MODE=true
